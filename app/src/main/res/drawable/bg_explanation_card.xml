<?xml version="1.0" encoding="utf-8"?>
<!-- Carte explication - bordure neon cyan -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#3300E5FF"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1A1A35"
                android:endColor="#0D0D1A"/>
            <stroke android:width="1dp" android:color="#5500E5FF"/>
        </shape>
    </item>
</layer-list>
