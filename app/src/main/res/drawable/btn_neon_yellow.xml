<?xml version="1.0" encoding="utf-8"?>
<!-- Gros bouton JOUER - jaune neon arcade -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp"/>
            <solid android:color="#33FFD700"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="36dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFB300"
                android:centerColor="#FFD700"
                android:endColor="#FFB300"/>
            <stroke android:width="2dp" android:color="#FFFF8D"/>
        </shape>
    </item>
</layer-list>
