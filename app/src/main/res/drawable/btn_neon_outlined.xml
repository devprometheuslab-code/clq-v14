<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton secondaire arcade - sombre avec halo neon -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <solid android:color="#22FFFFFF"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D0D1A"
                android:centerColor="#1A1A35"
                android:endColor="#0D0D1A"/>
            <stroke android:width="1.5dp" android:color="#33FFFFFF"/>
        </shape>
    </item>
</layer-list>
