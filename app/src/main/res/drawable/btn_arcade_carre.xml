<?xml version="1.0" encoding="utf-8"?>
<!-- Bouton mode CARRE - jaune neon arcade -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#33FFD600"/>
        </shape>
    </item>
    <item
        android:left="3dp"
        android:right="3dp"
        android:top="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#5C4D00"
                android:centerColor="#8C7300"
                android:endColor="#5C4D00"/>
            <stroke android:width="2dp" android:color="#FFD600"/>
        </shape>
    </item>
</layer-list>
