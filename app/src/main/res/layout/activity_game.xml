<!-- WHEEL OVERLAY -->
<LinearLayout
    android:id="@+id/layoutWheelOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#E60D0D1A"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvWheelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ROUE MAGIQUE !"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:layout_marginBottom="16dp"/>

    <com.prometheus.clq.ui.SpinWheelView
        android:id="@+id/spinWheel"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSpin"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:text="TOURNER !"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#E040FB"
        app:cornerRadius="28dp"
        android:layout_marginTop="20dp"/>

    <LinearLayout
        android:id="@+id/layoutWheelResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvWheelResultEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="48sp"/>

        <TextView
            android:id="@+id/tvWheelResultName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvWheelResultDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWheelContinue"
            android:layout_width="180dp"
            android:layout_height="48dp"
            android:text="Continuer"
            android:textSize="16sp"
            style="@style/CLQButtonPrimary"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</LinearLayout>

<!-- PASS PHONE OVERLAY -->
