<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPause" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_gravity="end" android:text="Pause" android:textAllCaps="false"
        android:textColor="@color/text_secondary" style="@style/Widget.MaterialComponents.Button.TextButton"/>
    <!-- ===== ALL PLAYERS STATUS BAR (always visible in multiplayer) ===== -->
    <HorizontalScrollView
        android:id="@+id/scrollPlayersBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="20dp"
        android:background="@color/bg_primary"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutPlayersBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <!-- Background d'arene dynamique selon la categorie de la question -->
    <ImageView
        android:id="@+id/ivCategoryBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35"
        android:contentDescription="@null"/>

    <!-- Overlay sombre pour garder la lisibilite du texte -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"/>

<LinearLayout
    android:id="@+id/layoutGameContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- TOP BAR: Progress + Timer + Score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"/>

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Timer Progress Bar -->
    <ProgressBar
        android:id="@+id/progressTimer"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="30"
        android:progressDrawable="@drawable/progress_timer"
        android:layout_marginBottom="6dp"/>

    <!-- ===== PLAYER BANNER WITH BIG AVATAR ===== -->
    <LinearLayout
        android:id="@+id/layoutPlayerBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_player_banner">

        <!-- Big Avatar with glow frame -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp">

            <View
                android:id="@+id/viewAvatarGlow"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/ivPlayerAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:contentDescription="Avatar du joueur"/>
        </FrameLayout>

        <!-- Player info column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name + Score row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCurrentPlayer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_gold"/>

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_purple"/>
            </LinearLayout>

            <!-- Streak + Combo + Wheel Points row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"/>

                <TextView
                    android:id="@+id/tvCombo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/neon_gold"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/neon_cyan"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Wheel Points + PV row (NOUVEAU) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <!-- Wheel Points indicator -->
                <TextView
                    android:id="@+id/tvWheelPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#E040FB"
                    android:textStyle="bold"
                    android:drawablePadding="4dp"/>

                <!-- Spins available indicator -->
                <TextView
                    android:id="@+id/tvSpinsAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    android:visibility="gone"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- Spell inventory count -->
                <TextView
                    android:id="@+id/tvSpellCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/neon_cyan"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- PV Bar (Glou mode only) -->
            <LinearLayout
                android:id="@+id/layoutPvBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressPV"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="30"
                    android:progress="30"
                    android:progressDrawable="@drawable/progress_pv_bar"/>

                <TextView
                    android:id="@+id/tvGlouPV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/glou_beer"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- QUESTION AREA (ScrollView) -->
    <ScrollView
        android:id="@+id/scrollQuestion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== DIFFICULTY SELECTION (NOUVEAU) ===== -->
            <LinearLayout
                android:id="@+id/layoutDifficultySelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choisis ta difficulté !"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/neon_gold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plus c'est dur, plus ça rapporte (points + roue)"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="16dp"/>

                <!-- EASY -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiffEasy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="🟢  FACILE  — +1 WP"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#2E7D32"
                    app:cornerRadius="14dp"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    app:icon="@drawable/ic_diff_easy"
                    app:iconTint="@null"
                    app:iconSize="34dp"
                    app:iconPadding="14dp"
                    app:iconGravity="start"/>

                <!-- MEDIUM -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiffMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="🟡  MOYEN  — +2 WP"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#805010"
                    app:cornerRadius="14dp"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    app:icon="@drawable/ic_diff_medium"
                    app:iconTint="@null"
                    app:iconSize="34dp"
                    app:iconPadding="14dp"
                    app:iconGravity="start"/>

                <!-- HARD -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiffHard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="🔴  DIFFICILE  — +3 WP"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#C62828"
                    app:cornerRadius="14dp"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    app:icon="@drawable/ic_diff_hard"
                    app:iconTint="@null"
                    app:iconSize="34dp"
                    app:iconPadding="14dp"
                    app:iconGravity="start"/>

                <!-- EXPERT -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiffExpert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="💀  EXPERT  — +4 WP"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#6A1B9A"
                    app:cornerRadius="14dp"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    app:icon="@drawable/ic_diff_expert"
                    app:iconTint="@null"
                    app:iconSize="34dp"
                    app:iconPadding="14dp"
                    app:iconGravity="start"/>
            </LinearLayout>

            <!-- QUESTION TEXT -->
            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_question_card"
                android:elevation="4dp"/>

            <!-- MODE SELECTION (DUO / CARRE / CASH) -->
            <LinearLayout
                android:id="@+id/layoutModeSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_choose_mode"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeDuo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="88dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="DUO"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#76FF03"
                        android:letterSpacing="0.10"
                        android:fontFamily="sans-serif-black"
                        android:background="@drawable/btn_arcade_duo"
                        android:shadowColor="#76FF03"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        app:backgroundTint="@null"
                        app:cornerRadius="0dp"
                        app:elevation="6dp"
                        app:icon="@drawable/ic_mode_duo"
                        app:iconGravity="top"
                        app:iconTint="@null"
                        app:iconSize="26dp"
                        app:iconPadding="2dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeCarre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="88dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="CARRÉ"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFD600"
                        android:letterSpacing="0.10"
                        android:fontFamily="sans-serif-black"
                        android:background="@drawable/btn_arcade_carre"
                        android:shadowColor="#FFD600"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        app:backgroundTint="@null"
                        app:cornerRadius="0dp"
                        app:elevation="6dp"
                        app:icon="@drawable/ic_mode_carre"
                        app:iconGravity="top"
                        app:iconTint="@null"
                        app:iconSize="26dp"
                        app:iconPadding="2dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeCash"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="88dp"
                        android:layout_weight="1"
                        android:text="CASH"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FF5252"
                        android:letterSpacing="0.10"
                        android:fontFamily="sans-serif-black"
                        android:background="@drawable/btn_arcade_cash"
                        android:shadowColor="#FF5252"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        app:backgroundTint="@null"
                        app:cornerRadius="0dp"
                        app:elevation="6dp"
                        app:icon="@drawable/ic_mode_cash"
                        app:iconGravity="top"
                        app:iconTint="@null"
                        app:iconSize="26dp"
                        app:iconPadding="2dp"/>
                </LinearLayout>

                <!-- Points preview per mode -->
                <LinearLayout
                    android:id="@+id/layoutPointsPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvDuoPoints"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/duo_green"/>

                    <TextView
                        android:id="@+id/tvCarrePoints"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/carre_yellow"/>

                    <TextView
                        android:id="@+id/tvCashPoints"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/cash_red"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ANSWER BUTTONS (DUO/CARRE) -->
            <LinearLayout
                android:id="@+id/layoutAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnswer0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/neon_purple"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:gravity="start|center_vertical"
                    android:minHeight="58dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnswer1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/neon_purple"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:gravity="start|center_vertical"
                    android:minHeight="58dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnswer2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/neon_purple"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:gravity="start|center_vertical"
                    android:minHeight="58dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnswer3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/neon_purple"
                    app:strokeWidth="2dp"
                    app:cornerRadius="14dp"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:gravity="start|center_vertical"
                    android:minHeight="58dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>
            </LinearLayout>

            <!-- CASH INPUT -->
            <LinearLayout
                android:id="@+id/layoutCashInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundColor="@color/bg_input"
                    app:boxStrokeColor="@color/cash_red"
                    app:hintTextColor="@color/text_tertiary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCashAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="@string/game_cash_hint"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                          android:inputType="text"
                          android:maxLength="256"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCashSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/game_cash_submit"
                    android:textSize="16sp"
                    style="@style/CLQButtonCash"/>
            </LinearLayout>

            <!-- GLOU EVENT DISPLAY -->
            <LinearLayout
                android:id="@+id/layoutGlouEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvGlouEventEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="48sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvGlouEventTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/glou_beer"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvGlouEventDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <!-- REVEAL INDICATOR (spell Revelation) -->
            <TextView
                android:id="@+id/tvRevealHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#FFD700"
                android:textStyle="bold|italic"
                android:background="#22FFD700"
                android:padding="8dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>
    <!-- RESULT -->
    <TextView
        android:id="@+id/tvResult" android:accessibilityLiveRegion="polite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- COMMENTAIRE DRÔLE (streak win/lose) — style arcade neon -->
    <TextView
        android:id="@+id/tvFunnyComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="italic|bold"
        android:textColor="#FFE082"
        android:gravity="center"
        android:padding="12dp"
