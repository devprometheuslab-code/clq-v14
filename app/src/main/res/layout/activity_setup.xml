<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupBack" android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="Retour" android:textColor="@color/text_secondary"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ta prochaine partie" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/neon_gold" android:letterSpacing="0.02"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Choisis les joueurs, puis règle le défi." android:textSize="13sp"
                android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Mode de jeu" android:textSize="14sp" android:textColor="@color/neon_cyan"
                    android:textStyle="bold" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeClassic"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_weight="1"
                    android:text="Classique" android:textSize="13sp"
                    style="@style/CLQButtonPrimary" android:layout_marginEnd="6dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeTimeAttack"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_weight="1"
                    android:text="Time Attack" android:textSize="13sp" android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/neon_purple" app:cornerRadius="12dp"
                    android:textColor="@color/text_secondary" android:layout_marginEnd="6dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeGlou"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_weight="1"
                    android:text="Glou" android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/glou_beer" app:cornerRadius="12dp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
            <TextView android:id="@+id/tvModeDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Joueurs" android:textSize="16sp" android:textColor="@color/neon_cyan" android:textStyle="bold"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRemovePlayer"
                    android:layout_width="48dp" android:layout_height="48dp" android:text="−"
                    android:contentDescription="Retirer le dernier joueur" android:padding="0dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <TextView android:id="@+id/tvPlayerCount" android:layout_width="52dp" android:layout_height="wrap_content"
                    android:text="1 / 6" android:textColor="@color/text_primary" android:gravity="center" android:textSize="15sp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAddPlayer"
                    android:layout_width="48dp" android:layout_height="48dp" android:text="+"
                    android:contentDescription="Ajouter un joueur" android:padding="0dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Avatar et profil : touche le portrait. Le nom est facultatif." android:textSize="12sp"
                android:textColor="@color/text_tertiary" android:layout_marginTop="4dp" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivAvatar1"
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp"
                        android:scaleType="centerCrop" android:background="@drawable/avatar_robot"
                        android:contentDescription="Changer l'avatar du joueur 1"/>
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlayer1"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Joueur 1" android:textSize="16sp" android:maxLength="16"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/bg_input_rounded" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:imeOptions="actionNext" android:inputType="textPersonName|textCapWords"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivAvatar2"
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp"
                        android:scaleType="centerCrop" android:background="@drawable/avatar_ninja"
                        android:contentDescription="Changer l'avatar du joueur 2"/>
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlayer2"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Joueur 2" android:textSize="16sp" android:maxLength="16"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/bg_input_rounded" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:imeOptions="actionNext" android:inputType="textPersonName|textCapWords"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivAvatar3"
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp"
                        android:scaleType="centerCrop" android:background="@drawable/avatar_pirate"
                        android:contentDescription="Changer l'avatar du joueur 3"/>
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlayer3"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Joueur 3" android:textSize="16sp" android:maxLength="16"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/bg_input_rounded" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:imeOptions="actionNext" android:inputType="textPersonName|textCapWords"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivAvatar4"
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp"
                        android:scaleType="centerCrop" android:background="@drawable/avatar_astronaut"
                        android:contentDescription="Changer l'avatar du joueur 4"/>
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlayer4"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Joueur 4" android:textSize="16sp" android:maxLength="16"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/bg_input_rounded" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:imeOptions="actionNext" android:inputType="textPersonName|textCapWords"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivAvatar5"
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp"
                        android:scaleType="centerCrop" android:background="@drawable/avatar_viking"
                        android:contentDescription="Changer l'avatar du joueur 5"/>
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlayer5"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Joueur 5" android:textSize="16sp" android:maxLength="16"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/bg_input_rounded" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:imeOptions="actionNext" android:inputType="textPersonName|textCapWords"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivAvatar6"
                        android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="10dp"
                        android:scaleType="centerCrop" android:background="@drawable/avatar_wizard"
                        android:contentDescription="Changer l'avatar du joueur 6"/>
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlayer6"
                        android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                        android:hint="Joueur 6" android:textSize="16sp" android:maxLength="16"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary"
                        android:background="@drawable/bg_input_rounded" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:imeOptions="actionNext" android:inputType="textPersonName|textCapWords"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Questions par joueur" android:textSize="14sp" android:textColor="@color/neon_cyan" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvQuestionsValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/neon_gold"/>
                </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderQuestions" android:contentDescription="Nombre de questions par joueur"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:valueFrom="5" android:valueTo="30" android:value="10" android:stepSize="5"
                app:thumbColor="@color/neon_purple" app:trackColorActive="@color/neon_purple"
                app:trackColorInactive="@color/bg_input" app:labelBehavior="gone"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Temps par question" android:textSize="14sp" android:textColor="@color/neon_cyan" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvTimeValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/neon_gold"/>
                </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTime" android:contentDescription="Secondes par question"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:valueFrom="10" android:valueTo="60" android:value="30" android:stepSize="5"
                app:thumbColor="@color/neon_purple" app:trackColorActive="@color/neon_purple"
                app:trackColorInactive="@color/bg_input" app:labelBehavior="gone"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Catégorie" android:textSize="14sp" android:textColor="@color/neon_cyan"
                    android:textStyle="bold" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinnerCategory" android:contentDescription="Catégorie des questions"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_input_rounded"
                android:popupBackground="@color/bg_card"
                android:paddingStart="4dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Barre du bas toujours visible : résumé + bouton lancer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">
        <TextView android:id="@+id/tvSetupSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/setup_start"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            style="@style/CLQButtonPrimary"/>
    </LinearLayout>
</LinearLayout>
